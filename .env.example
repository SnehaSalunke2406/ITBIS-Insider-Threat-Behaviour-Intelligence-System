# Copy this file to .env for local Windows use.
# Leave DB_PASSWORD blank to use the built-in SQLite fallback.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itbis
DB_USER=postgres
DB_PASSWORD=
SQLITE_PATH=itbis_local.db
MONGO_URL=mongodb://localhost:27017
MONGO_DB=itbis
JWT_SECRET=itbis-local-demo-secret-change-me
JWT_EXPIRES_MINUTES=480
AUTO_SEED=true
PREFER_POSTGRES=true
